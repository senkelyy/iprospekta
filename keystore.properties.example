# Copiez ce fichier en "keystore.properties" (ignore par git) pour signer en local.
# Generez d'abord un keystore :
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias iprospekta
KEYSTORE_FILE=release.jks
KEYSTORE_PASSWORD=motdepasse_du_store
KEY_ALIAS=iprospekta
KEY_PASSWORD=motdepasse_de_la_cle
